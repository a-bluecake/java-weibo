<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.culr.edu.work1013.mapper.WeiboMapper">
    <select id="selectWeiboExpressVO" resultType="cn.culr.edu.work1013.pojo.vo.WeiboExpressVO">
        SELECT weibo.content,user.nickname,weibo.created FROM weibo JOIN user on weibo.user_id=user.id
    </select>
    <insert id="insert">
        insert into weibo values(null,#{content},#{created},#{UserId})
    </insert>
</mapper>