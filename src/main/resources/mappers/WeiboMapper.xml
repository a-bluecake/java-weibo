<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.culr.edu.weiboproject.mapper.WeiboMapper">
    <select id="selectWeiboExpressVO" resultType="cn.culr.edu.weiboproject.pojo.vo.WeiboExpressVO">
        SELECT weibo.id,weibo.content,user.nickname,weibo.created FROM weibo JOIN user on weibo.user_id=user.id
    </select>
    <insert id="insert">
        insert into weibo values(null,#{content},#{created},#{userId})
    </insert>
    <select id="selectByWeiboId" resultType="cn.culr.edu.weiboproject.pojo.entity.Weibo">
        SELECT *,user_id as userId FROM weibo WHERE id=#{id}
    </select>
</mapper>