<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.culr.edu.weiboproject.mapper.UserMapper">
    <select id="selectByUsername" resultType="cn.culr.edu.weiboproject.pojo.entity.User">
        select * from user where username = #{username}
    </select>
    <select id="selectByNickname" resultType="cn.culr.edu.weiboproject.pojo.entity.User">
        select * from user where nickname = #{nickname}
    </select>
    <insert id="insert">
        insert into user values (null ,#{username} ,#{password} ,#{nickname} ,#{created})
    </insert>
    <select id="selectByWeiboUserId" resultType="cn.culr.edu.weiboproject.pojo.entity.User">
        select DISTINCT user.id,user.username,user.password,user.nickname,user.created
        from weibo join user on weibo.user_id = user.id
        where weibo.user_id = #{userId}
    </select>
</mapper>
